{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nuwa-app values",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "owner", "image", "port", "resources"],
  "properties": {
    "name": {
      "description": "The app's name: DNS label, also used for resource names.",
      "type": "string",
      "pattern": "^[a-z]([-a-z0-9]{0,40}[a-z0-9])?$"
    },
    "owner": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9_.]{0,61}[a-z0-9])?$" },
    "partOf": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9_.]{0,61}[a-z0-9])?$" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "tag": { "type": "string", "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$" }
      }
    },
    "replicas": { "type": "integer", "minimum": 0, "maximum": 10 },
    "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "readyPath": { "type": "string", "pattern": "^(/.*)?$" },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "startupFailureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "command": { "type": "array", "items": { "type": "string" } },
    "args": { "type": "array", "items": { "type": "string" } },
    "env": { "$ref": "#/definitions/env" },
    "secretEnv": { "$ref": "#/definitions/secretEnv" },
    "externalSecrets": {
      "description": "Secrets ESO fills from OpenBao (apps/meru/<namespace>/eso/<name>), name -> settings.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Opaque",
              "kubernetes.io/basic-auth",
              "kubernetes.io/dockerconfigjson",
              "kubernetes.io/ssh-auth",
              "kubernetes.io/tls"
            ]
          }
        }
      }
    },
    "openbao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addr", "refreshInterval", "caCert"],
      "properties": {
        "addr": { "type": "string", "pattern": "^https://" },
        "refreshInterval": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
        "caCert": { "type": "string", "pattern": "BEGIN CERTIFICATE" }
      }
    },
    "migrate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": { "$ref": "#/definitions/env" },
        "secretEnv": { "$ref": "#/definitions/secretEnv" },
        "timeoutSeconds": { "type": "integer", "minimum": 30 }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": "string" }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["memory"],
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": "string" }
          }
        }
      }
    },
    "runAsUser": { "type": "integer", "minimum": 1 },
    "tmp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "sizeLimit": { "type": "string" }
      }
    },
    "persistence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "mountPath", "size"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z]([-a-z0-9]{0,20}[a-z0-9])?$" },
          "mountPath": { "type": "string", "pattern": "^/" },
          "size": { "type": "string" },
          "storageClass": { "enum": ["local", "hdd"] }
        }
      }
    },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": { "type": "string" }
      }
    },
    "global": { "type": "object" }
  },
  "definitions": {
    "env": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": "string" }
    },
    "secretEnv": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["secret", "key"],
        "properties": {
          "secret": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" },
          "key": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
